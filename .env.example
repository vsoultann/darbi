# Copy to .env for local development. On Replit put these in Secrets instead.

# Port the single Node process listens on (Replit injects PORT automatically).
PORT=5174

# Admin console PIN — never shipped to the client bundle.
ADMIN_PIN=1970

# Driver view PIN.
DRIVER_PIN=4040

# Signing key for the 12h admin/driver tokens. Change this before any public demo.
JWT_SECRET=change-me-before-you-demo

# Authoritative trip tick, in milliseconds.
TICK_MS=250
